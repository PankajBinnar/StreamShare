# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL) - port 5433 to avoid conflicts with local Postgres
DATABASE_URL="postgresql://streamshare_user:streamshare_secure_password_2026@localhost:5433/streamshare_db?schema=public"

# Cryptographic Secrets (Rotate periodically, min 32 chars)
JWT_ACCESS_SECRET="streamshare_super_secure_access_jwt_secret_key_2026_xyz!"
JWT_REFRESH_SECRET="streamshare_super_secure_refresh_jwt_secret_key_2026_abc@"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# CORS & Client Origin
CLIENT_ORIGIN="http://localhost:3000"

# Redis Cache & Online Presence (Connect to your existing Redis Stack on 6379)
REDIS_URL="redis://localhost:6379"
ENABLE_CACHE="true"

# Admin Route Security - IP Restriction (comma separated list of allowed IPs or '*' for testing)
ADMIN_ALLOWED_IPS="127.0.0.1,::1,::ffff:127.0.0.1"

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_MAX=60
